# ─────────────────────────────────────────────────────────────────────
# Miranda API — variáveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores:
#     cp .env.example .env
# O arquivo `.env` está no .gitignore e NUNCA deve ser versionado.
# ─────────────────────────────────────────────────────────────────────

# String de conexão do PostgreSQL (usuário e banco criados nativamente no Ubuntu).
# Formato: postgresql+psycopg2://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql+psycopg2://miranda_user:miranda_senha_local@localhost:5432/miranda

# Chave secreta usada para assinar os tokens JWT.
# Gere uma chave forte com:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ATENÇÃO: a aplicação NÃO SOBE com o valor de exemplo abaixo, nem com qualquer
# chave de menos de 32 caracteres (ver o validator em app/core/config.py). Como
# este arquivo é versionado, a chave de exemplo é pública: subir com ela
# permitiria a qualquer pessoa forjar um token de qualquer usuário.
JWT_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-secreta
JWT_ALGORITHM=HS256
# Duração do token de acesso, em minutos.
# 720 = 12 horas. Sem refresh token implementado, este prazo é o único limite
# para um token vazado — evite aumentá-lo. A troca de senha já invalida todos os
# tokens na hora, independente deste valor.
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Servidor
# 127.0.0.1 = a API só aceita conexões da própria máquina (padrão seguro).
# Use 0.0.0.0 APENAS quando precisar alcançar a API de outro aparelho da rede
# local — por exemplo, testar o app num celular físico. Nesse caso a API fica
# exposta a todos os dispositivos da rede; prefira voltar para 127.0.0.1 depois.
HOST=127.0.0.1
PORT=8000

# ── IA (análise de peça, self-hosted) ────────────────────────────────
# Limiares de confiança (score softmax 0-1) do FashionCLIP, UM POR CAMPO. O
# rótulo vencedor só preenche o campo se o score for >= o limiar; abaixo disso o
# campo fica nulo, para o usuário preencher à mão. Calibre com fotos reais usando
# scripts/calibrate_fashion_clip.py.
#
# Os padrões vêm da calibração real:
#   - categoria (0.80): confiança decisiva (topo perto de 1.0 na maioria).
#   - estampa   (0.85): idem, decisiva; deixa nulo só em ambiguidades legítimas.
#   - formalidade (0.60): estruturalmente difusa — a probabilidade se divide
#     entre casual/smart_casual/social, então um limiar alto a deixaria quase
#     sempre nula. O corte mais baixo preenche mais mantendo escolhas plausíveis.
FASHION_CLIP_THRESHOLD_CATEGORIA=0.80
FASHION_CLIP_THRESHOLD_ESTAMPA=0.85
FASHION_CLIP_THRESHOLD_FORMALIDADE=0.60

# Origens permitidas para CORS (frontend Next.js), separadas por vírgula.
# ATENÇÃO: "*" com CORS_ALLOW_CREDENTIALS=true é recusado no boot — a combinação
# liberaria qualquer site da internet a chamar a API com as credenciais do
# usuário. Liste as origens explicitamente.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Headers de segurança. HSTS obriga o navegador a só falar HTTPS com este host;
# deixe false enquanto a API rodar em http://localhost, senão o navegador passa
# a exigir HTTPS do próprio localhost. Ligue quando estiver atrás de HTTPS.
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000

# Storage local de imagens. As imagens NÃO são servidas por rota estática
# pública: saem por GET /api/wardrobe/items/{id}/image, que exige
# autenticação e confere a posse da peça.
# STORAGE_DIR pode ser deixado em branco para usar o padrão (miranda-api/storage/clothing_images).
PUBLIC_BASE_URL=http://localhost:8000

# ── IA paga: composição do look do dia (API da Anthropic) ────────────
# ATENÇÃO: diferente da análise de peça (self-hosted e gratuita), a geração do
# look do dia chama a API do Claude e CUSTA DINHEIRO por requisição.
#
# Crie uma chave em https://console.anthropic.com/settings/keys e cole abaixo.
# Deixar em branco NÃO derruba a aplicação: a geração de look passa a devolver
# uma nota explicando que não foi possível gerar agora.
ANTHROPIC_API_KEY=

# Modelo usado na composição. Trocar aqui basta — nenhum código referencia o
# identificador diretamente. Ao trocar, revise os preços em
# services/ai/claude_client.py, que alimentam o log de custo estimado.
ANTHROPIC_MODEL=claude-opus-5

# Teto de tokens de saída por geração.
ANTHROPIC_MAX_OUTPUT_TOKENS=4000

# Profundidade de raciocínio: low | medium | high | xhigh | max.
# Ocupa o lugar do antigo `temperature`, que os modelos atuais rejeitam com
# HTTP 400. "medium" prioriza consistência sobre criatividade.
ANTHROPIC_EFFORT=medium

# Tentativas totais por geração (rede, rate limit, resposta ilegível).
ANTHROPIC_MAX_ATTEMPTS=3
ANTHROPIC_TIMEOUT_SECONDS=60.0

# Cache de prompt no manual de estilo. DESLIGADO por padrão, de propósito.
# Gravar o cache custa 1,25x o preço de entrada e ler custa 0,10x, mas a janela
# do cache é de 5 MINUTOS. Com gerações esparsas quase toda chamada seria uma
# gravação, saindo ~9% mais cara do que sem cache nenhum.
# Ligue quando o produto tiver volume real — gerações a poucos minutos umas das
# outras. O prefixo é o mesmo para todos os usuários, então conta o volume
# TOTAL, não o de cada pessoa. Ver README, seção 12.
ENABLE_PROMPT_CACHE=false

# ── Envio de e-mail ──────────────────────────────────────────────────
# console — só registra no log. Padrão; funciona sem Docker e sem conta externa.
# smtp    — Mailpit local. Rode `docker compose up -d` e leia em
#           http://localhost:8025. NÃO envia nada para fora da máquina.
# resend  — serviço real, para quando o projeto for hospedado. Exige
#           RESEND_API_KEY e um domínio verificado para enviar a terceiros.
EMAIL_BACKEND=console
EMAIL_FROM=Miranda <nao-responda@miranda.local>

# Usados só quando EMAIL_BACKEND=smtp.
SMTP_HOST=localhost
SMTP_PORT=1025

# Usado só quando EMAIL_BACKEND=resend. Crie em https://resend.com/api-keys
RESEND_API_KEY=

# Base das URLs que vão DENTRO dos e-mails — é o FRONTEND, não a API.
APP_BASE_URL=http://localhost:3000

# ── Verificação de e-mail ────────────────────────────────────────────
# Exigir e-mail confirmado para entrar. DESLIGADO por padrão: ligá-lo sem
# entrega de e-mail confiável tranca todo mundo para fora, inclusive as contas
# criadas antes desta feature. Com a flag ligada, só o LOGIN é recusado (403);
# o cadastro não autentica ninguém e segue respondendo igual.
REQUIRE_VERIFIED_EMAIL=false

# Validade do link de confirmação, em horas.
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# ── Rate limiting ────────────────────────────────────────────────────
# Storage do rate limiter. `memory://` só é correto com UM worker do uvicorn.
# Suba o Redis com `docker compose up -d` (ver README, seção de instalação).
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

# ── Guarda-roupa ─────────────────────────────────────────────────────
# Teto de peças por conta. Generoso para um guarda-roupa real, finito para um
# script — sem ele, uma conta pode encher o disco e a tabela.
MAX_ITEMS_PER_USER=150
